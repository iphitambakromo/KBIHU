{
  "name": "iphi",
  "version": "1.0.0",
  "private": true,
  "description": "IPHI \u2014 Tracking Amanah Mengawal Barisan (rebuild): satu peta GPS, titik kumpul, absensi, radar BLE, simulasi",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').cpSync('public','dist',{recursive:true})\"",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "wrangler d1 execute iphi-db --local --file=schema.sql"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}